# MariaDB
AITM_DB_ROOT_PASSWORD=change-this-root-password
AITM_DB_PASSWORD=change-this-app-password

# Internal AI service authentication
RESTOK_AI_SECURE_TOKEN=change-this-long-random-token

# Optional: enables RAG/LLM coaching. Pose analysis still works without it.
OPENAI_API_KEY=

# Comma-separated allowlist for remote direct-video URLs.
AITM_ALLOWED_VIDEO_HOSTS=storage.googleapis.com
