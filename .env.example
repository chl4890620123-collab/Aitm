# Windows Docker Desktop storage root. Use forward slashes.
AITM_DATA_ROOT=C:/AITM/data
AITM_APP_USERNAME=admin
AITM_APP_PASSWORD=replace-with-a-strong-login-password
RESTOK_DB_PASSWORD=replace-with-a-strong-password
RESTOK_AI_SECURE_TOKEN=replace-with-a-long-random-token
RESTOK_VIDEO_SIGNING_KEY=replace-with-another-long-random-token
OPENAI_API_KEY=your_openai_api_key_here
ALLOW_OPENAI_EGRESS=true
RESTOK_VIDEO_ALLOWED_HOSTS=localhost,127.0.0.1,s3.amazonaws.com,storage.googleapis.com
RESTOK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAG_CACHE_SECONDS=300
